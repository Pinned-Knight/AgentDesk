# Copy to backend/.env (or export) — every value is optional; defaults run a fully in-memory demo.

# Infrastructure: leave unset to use in-memory mongomock / fakeredis
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=agentdesk
REDIS_URL=redis://localhost:6379/0

# LLM: "mock" (offline, deterministic) or "openai_compat" (any OpenAI-compatible endpoint)
LLM_PROVIDER=mock
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   # Gemini
# LLM_BASE_URL=http://localhost:11434/v1                                  # Ollama
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# Behaviour
RATE_LIMIT_PER_MIN=30
CACHE_TTL_S=300
MEMORY_TURNS=8
